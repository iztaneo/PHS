                  "targetId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "description": "Hito, riesgo o cambio del mismo proyecto."
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "file": {
                    "description": "Archivo binario: PNG, JPEG, WebP, PDF, DOCX, XLSX o PPTX sin macros, hasta 10 MB.",
                    "type": "string"
                  }
                },
                "required": [
                  "projectId",
                  "kind",
                  "targetId"
                ]
              }
            }
          }
        },
