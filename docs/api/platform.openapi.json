                      ]
                    },
                    "file": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "mime": {
                              "type": "string"
                            },
                            "sizeBytes": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "name",
                            "mime",
                            "sizeBytes"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "uploadedBy": {
                      "type": "object",
