{
  "openapi": "3.1.0",
  "info": {
    "title": "PHS — Servicio Proyectos (interno)",
    "version": "0.1.0",
    "description": "API interna. Recibe del gateway la identidad firmada del usuario y aplica el alcance de D05."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Estado del servicio y de su base de datos",
        "tags": [
          "Estado"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Estado actual.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "service": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "down"
                      ]
                    }
                  },
                  "required": [
                    "service",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/projects": {
      "get": {
        "summary": "Proyectos al alcance del usuario",
        "tags": [
          "Proyectos"
        ],
        "security": [
          {
            "gatewaySignature": []
          }
        ],
        "responses": {
          "200": {
            "description": "Solo los proyectos que el usuario puede consultar.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "code": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "planned",
                          "active",
                          "paused",
                          "renewing",
                          "closed"
                        ]
                      },
                      "practiceId": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "practiceName": {
                        "type": "string"
                      },
                      "clientName": {
                        "type": "string"
                      },
                      "capabilities": {
                        "type": "object",
                        "properties": {
                          "view": {
                            "type": "boolean"
                          },
                          "editOperation": {
                            "type": "boolean",
                            "description": "Editar hitos, riesgos, economía y renovaciones."
                          },
                          "proposeAndReview": {
                            "type": "boolean",
                            "description": "Proponer cambios y enviar revisiones."
                          },
                          "decide": {
                            "type": "boolean",
                            "description": "Aprobar cambios y validar revisiones."
                          },
                          "seeFinancials": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "view",
                          "editOperation",
                          "proposeAndReview",
                          "decide",
                          "seeFinancials"
                        ],
                        "additionalProperties": false,
                        "description": "Lo que el usuario puede hacer en este proyecto según D05."
                      }
                    },
                    "required": [
                      "id",
                      "code",
                      "name",
                      "status",
                      "practiceId",
                      "practiceName",
                      "clientName",
                      "capabilities"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión válida (`authentication_required`).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Código estable del error, pensado para que el cliente decida el mensaje."
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/projects/{id}": {
      "get": {
        "summary": "Un proyecto al alcance del usuario",
        "tags": [
          "Proyectos"
        ],
        "security": [
          {
            "gatewaySignature": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Proyecto.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "code": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "planned",
                        "active",
                        "paused",
                        "renewing",
                        "closed"
                      ]
                    },
                    "practiceId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "practiceName": {
                      "type": "string"
                    },
                    "clientName": {
                      "type": "string"
                    },
                    "capabilities": {
                      "type": "object",
                      "properties": {
                        "view": {
                          "type": "boolean"
                        },
                        "editOperation": {
                          "type": "boolean",
                          "description": "Editar hitos, riesgos, economía y renovaciones."
                        },
                        "proposeAndReview": {
                          "type": "boolean",
                          "description": "Proponer cambios y enviar revisiones."
                        },
                        "decide": {
                          "type": "boolean",
                          "description": "Aprobar cambios y validar revisiones."
                        },
                        "seeFinancials": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "view",
                        "editOperation",
                        "proposeAndReview",
                        "decide",
                        "seeFinancials"
                      ],
                      "additionalProperties": false,
                      "description": "Lo que el usuario puede hacer en este proyecto según D05."
                    }
                  },
                  "required": [
                    "id",
                    "code",
                    "name",
                    "status",
                    "practiceId",
                    "practiceName",
                    "clientName",
                    "capabilities"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión válida (`authentication_required`).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Código estable del error, pensado para que el cliente decida el mensaje."
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "No existe o está fuera del alcance del usuario (`not_found`).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Código estable del error, pensado para que el cliente decida el mensaje."
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/catalog/service-types": {
      "get": {
        "summary": "Catálogo de tipos de servicio",
        "tags": [
          "Catálogos"
        ],
        "security": [
          {
            "gatewaySignature": []
          }
        ],
        "responses": {
          "200": {
            "description": "Tipos activos e inactivos.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "active": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "code",
                      "name",
                      "active"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión válida (`authentication_required`).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Código estable del error, pensado para que el cliente decida el mensaje."
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Agregar tipo de servicio",
        "tags": [
          "Catálogos"
        ],
        "security": [
          {
            "gatewaySignature": []
          }
        ],
        "description": "Requiere un usuario administrador.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{1,39}$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "required": [
                  "code",
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tipo creado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "active": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "code",
                    "name",
                    "active"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos (`invalid_request`).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Código estable del error, pensado para que el cliente decida el mensaje."
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión válida (`authentication_required`).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Código estable del error, pensado para que el cliente decida el mensaje."
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "Sin permiso (`forbidden`).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Código estable del error, pensado para que el cliente decida el mensaje."
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "409": {
            "description": "Código o nombre ya usados (`code_taken`).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Código estable del error, pensado para que el cliente decida el mensaje."
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/catalog/service-types/{code}": {
      "patch": {
        "summary": "Activar o desactivar un tipo de servicio",
        "tags": [
          "Catálogos"
        ],
        "security": [
          {
            "gatewaySignature": []
          }
        ],
        "description": "Requiere un usuario administrador.",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "active": {
                    "type": "boolean",
                    "description": "false lo oculta para nuevos proyectos; los existentes lo conservan."
                  }
                },
                "required": [
                  "active"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tipo actualizado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "active": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "code",
                    "name",
                    "active"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos (`invalid_request`).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Código estable del error, pensado para que el cliente decida el mensaje."
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión válida (`authentication_required`).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Código estable del error, pensado para que el cliente decida el mensaje."
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "Sin permiso (`forbidden`).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Código estable del error, pensado para que el cliente decida el mensaje."
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "No existe o está fuera del alcance del usuario (`not_found`).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "description": "Código estable del error, pensado para que el cliente decida el mensaje."
                    }
                  },
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "phs_session",
        "description": "Cookie de sesión emitida por POST /api/v1/session."
      },
      "gatewaySignature": {
        "type": "apiKey",
        "in": "header",
        "name": "x-phs-internal-auth",
        "description": "Identidad firmada por el gateway (HMAC-SHA256, válida 60 s). No se acepta desde el navegador."
      }
    }
  }
}
