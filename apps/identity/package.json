{
  "name": "@phs/identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json && (tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch dist/main.js)",
    "test": "vitest run",
    "create-user": "node dist/cli/create-user.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@phs/service-kit": "workspace:*",
    "pg": "8.23.1",
    "@node-rs/argon2": "2.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/node": "24.10.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "@types/pg": "8.23.1",
    "@types/express": "5.0.6"
  }
}
