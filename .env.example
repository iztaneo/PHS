# Copiar a .env para desarrollo local. No guardar secretos reales en este archivo.
# Valores solo para el PostgreSQL local de docker-compose.yml.
POSTGRES_USER=phs
POSTGRES_PASSWORD=phs_local_dev
POSTGRES_DB=phs
POSTGRES_PORT=54329
DATABASE_URL=postgres://phs:phs_local_dev@127.0.0.1:54329/phs

GATEWAY_PORT=3000
IDENTITY_PORT=3001
PROJECTS_PORT=3002
IDENTITY_URL=http://127.0.0.1:3001
PROJECTS_URL=http://127.0.0.1:3002
