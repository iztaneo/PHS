# Copiar a .env para desarrollo local. No guardar secretos reales en este archivo.
# Valores solo para el PostgreSQL local (scripts/local-db.sh o docker-compose.yml).
# El propietario no debe llamarse igual que el esquema (phs): PostgreSQL lo usaría como esquema por defecto.
POSTGRES_USER=phs_owner
POSTGRES_PASSWORD=phs_local_dev
POSTGRES_DB=phs
POSTGRES_PORT=54329
# Propietario del esquema: solo para migraciones y pruebas SQL.
DATABASE_URL=postgres://phs_owner:phs_local_dev@127.0.0.1:54329/phs?sslmode=disable
# Cada servicio se conecta con su propio usuario, miembro del rol de su servicio.
IDENTITY_DATABASE_URL=postgres://phs_identity_dev:phs_local_dev@127.0.0.1:54329/phs
PROJECTS_DATABASE_URL=postgres://phs_projects_dev:phs_local_dev@127.0.0.1:54329/phs

GATEWAY_PORT=3000
IDENTITY_PORT=3001
PROJECTS_PORT=3002
IDENTITY_URL=http://127.0.0.1:3001
PROJECTS_URL=http://127.0.0.1:3002

# Secreto compartido entre el gateway y los servicios (mínimo 32 caracteres). Valor solo local.
INTERNAL_AUTH_SECRET=local-dev-only-internal-secret-0000000000
# Cookie de sesión sin Secure solo porque en local se usa http. En cualquier otro entorno: true.
COOKIE_SECURE=false
WEB_ORIGIN=http://127.0.0.1:5173
# Publica Swagger UI en /api/docs y los contratos en /openapi.json. Solo para desarrollo local.
API_DOCS=true

# Base separada para pruebas de integración (pnpm db:test:setup).
IDENTITY_TEST_DATABASE_URL=postgres://phs_identity_dev:phs_local_dev@127.0.0.1:54329/phs_test
PROJECTS_TEST_DATABASE_URL=postgres://phs_projects_dev:phs_local_dev@127.0.0.1:54329/phs_test
OWNER_TEST_DATABASE_URL=postgres://phs_owner:phs_local_dev@127.0.0.1:54329/phs_test

# Usuario inicial de desarrollo (pnpm seed:dev), creado como administrador. Contraseña temporal: la app obliga a cambiarla al entrar.
DEV_USER_EMAIL=admin@phs.test
DEV_USER_NAME="Administrador local"
DEV_USER_PASSWORD=temporal-solo-local-1

# Usuarios de demostración (pnpm seed:demo): ana.pm, luis.lider, carla.direccion, pablo.pm, diego.dev y
# elena.lectora, todos @phs.test. Comparten esta contraseña y no se les pide cambiarla. Solo para desarrollo local.
DEMO_USER_PASSWORD=demo-solo-local-2026
